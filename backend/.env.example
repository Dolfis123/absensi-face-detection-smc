PORT=4000
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smc_faceattend
DB_USER=root
DB_PASSWORD=

# JWT — ganti dengan string acak panjang
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
JWT_EXPIRES=12h

# Python face-service
FACE_SERVICE_URL=http://127.0.0.1:8001
# Jarak cosine maksimum agar wajah dianggap cocok saat absen (mesin SFace). Makin kecil makin ketat.
FACE_MAX_DISTANCE=0.55
# Pendaftaran butuh persetujuan Super Admin bila jaraknya ke karyawan lain di bawah nilai ini
FACE_DUPLICATE_DISTANCE=0.4

# Toleransi keterlambatan Absen Masuk (menit setelah jendela masuk berakhir)
LATE_TOLERANCE_MINUTES=120

# Akun Super Admin (HANYA dibuat sekali saat database pertama kali disiapkan,
# setelah itu permanen: tidak bisa diedit/dihapus, termasuk lewat file ini)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=GantiPasswordKuat!2026
SUPER_ADMIN_FULLNAME=Super Admin SMC
SUPER_ADMIN_NIK=SMC-0001
SUPER_ADMIN_PHONE=081200000000

# Titik awal pos parkir (PLACEHOLDER — wajib diganti Super Admin dari menu Geofence
# dengan koordinat hasil pengukuran langsung di pos parkir Mal SMC)
GEOFENCE_LAT=-0.876800
GEOFENCE_LNG=131.255800
GEOFENCE_RADIUS_M=5
GEOFENCE_MAX_ACCURACY_M=15

UPLOAD_DIR=uploads
